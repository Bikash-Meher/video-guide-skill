# Video Guide Skill — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Audio cache (regenerated per run)
audio_tracks/
*.wav

# Extracted frames (large, regenerated)
*_frames/
*.png

# Rendered videos (large outputs)
*.mp4
*.srt

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp

# Secrets
.env
*.key
