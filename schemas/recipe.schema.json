{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/YOUR_USERNAME/video-guide-skill/schemas/recipe.schema.json",
  "title": "Video Guide Engine Recipe",
  "description": "Recipe JSON consumed directly by engine.py. Authored by the AI agent after extracting 3 FPS frames and analyzing all frames of the recording.",
  "type": "object",
  "required": ["timeline_mapping", "steps"],
  "additionalProperties": true,
  "properties": {
    "source_video": {
      "type": ["string", "null"],
      "description": "Path to the original screen recording (.mp4, .mov, .mkv)."
    },
    "frames_dir": {
      "type": ["string", "null"],
      "description": "Path to directory containing 3 FPS extracted PNG frames (%04d_frame.png)."
    },
    "fps_extracted": {
      "type": "number",
      "default": 3.0,
      "description": "Frame extraction rate (default 3.0 = 3 images per second)."
    },
    "input_source": {
      "type": "string",
      "enum": ["auto", "video", "frames"],
      "default": "auto",
      "description": "'auto' selects video if present (sharper 30fps playback) or frames_dir; 'frames' reads 3fps PNGs directly."
    },
    "auto_extract_frames": {
      "type": "boolean",
      "default": true
    },
    "coord_mode": {
      "type": "string",
      "enum": ["auto", "pixels", "normalized", "reference"],
      "default": "auto"
    },
    "reference_resolution": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2,
      "examples": [[1920, 1080]]
    },
    "target_aspect": {
      "type": "string",
      "enum": ["native", "16:9", "9:16", "4:3", "1:1"],
      "default": "native"
    },
    "branding_text": {
      "type": "string",
      "description": "Top-corner branding pill text, e.g. 'My App • User Guide'."
    },
    "branding_position": {
      "type": "string",
      "enum": ["top-right", "top-left", "bottom-right", "bottom-left", "hidden"],
      "default": "top-right"
    },
    "preset": {
      "type": "string",
      "enum": ["tech_hud", "clean_light", "minimal", "high_contrast"],
      "default": "tech_hud",
      "description": "Visual HUD color theme preset (note: 'theme' if set must be an override dict, never a string)."
    },
    "theme": {
      "type": "object",
      "description": "Optional dict of color overrides merged over preset.",
      "additionalProperties": true
    },
    "tone": {
      "type": "string",
      "enum": ["professional", "energetic", "calm", "corporate", "friendly"],
      "default": "friendly",
      "description": "Narration pacing & visual preset."
    },
    "default_voice": {
      "type": "string",
      "default": "en-IN-NeerjaNeural",
      "examples": [
        "en-IN-NeerjaNeural",
        "en-IN-PrabhatNeural",
        "en-US-JennyNeural",
        "en-US-GuyNeural",
        "en-GB-SoniaNeural",
        "en-GB-RyanNeural"
      ]
    },
    "dock_mode": {
      "type": "string",
      "enum": ["auto", "below", "overlay"],
      "default": "auto"
    },
    "dock_position": {
      "type": "string",
      "enum": ["auto", "below", "bottom", "top", "bottom-center", "top-center", "bottom-left", "bottom-right", "top-left", "top-right", "mid-left", "mid-right", "hidden"],
      "default": "auto"
    },
    "dock_width_mode": {
      "type": "string",
      "enum": ["auto", "wide"],
      "default": "auto"
    },
    "total_duration": {
      "type": ["number", "string"],
      "default": "auto",
      "description": "'auto' calculates final length cleanly from timeline, steps, and TTS durations."
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "audio_timing_mode": {
      "type": "string",
      "enum": ["warn", "auto_shift"],
      "default": "auto_shift"
    },
    "background_music": {
      "type": "boolean",
      "default": true
    },
    "export_subtitles": {
      "type": "boolean",
      "default": true
    },
    "timeline_mapping": {
      "type": "array",
      "minItems": 1,
      "description": "Maps output video seconds cleanly to source frames (trimming dead pauses or speeding through typing).",
      "items": {
        "type": "object",
        "required": ["start_sec", "end_sec"],
        "properties": {
          "start_sec": {"type": "number"},
          "end_sec": {"type": "number"},
          "source_frame_start_3fps": {"type": "integer", "minimum": 0},
          "source_frame_end_3fps": {"type": "integer", "minimum": 0},
          "source_frame_start": {"type": "integer", "minimum": 0},
          "source_frame_end": {"type": "integer", "minimum": 0}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered tutorial steps with voiceover narration and dynamic HUD overlays.",
      "items": {
        "type": "object",
        "required": ["id", "start_time", "active_start", "active_end", "narration"],
        "properties": {
          "id": {"type": "string", "examples": ["intro", "step1", "complete"]},
          "start_time": {"type": "number", "description": "Audio voiceover start time in seconds."},
          "active_start": {"type": "number", "description": "HUD step display start in seconds."},
          "active_end": {"type": "number", "description": "HUD step display end in seconds."},
          "step_num": {"type": "string", "examples": ["INTRO", "STEP 1", "COMPLETE"]},
          "step_title": {"type": "string"},
          "narration": {"type": "string", "description": "Voiceover script synthesized via Edge TTS."},
          "sub": {"type": "string", "description": "1-2 line HUD dock caption shown at bottom."},
          "voice": {"type": "string"},
          "spotlight": {
            "type": ["boolean", "object"],
            "description": "True or {rects: [[x1,y1,x2,y2]], dim_alpha: 0.35} to dim non-target areas."
          },
          "zoom": {
            "type": "object",
            "properties": {
              "rect": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
              "transition_sec": {"type": "number", "default": 0.45},
              "ease": {"type": "boolean", "default": true}
            }
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rect"],
              "properties": {
                "rect": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
                "color": {"type": "array", "items": {"type": "integer"}},
                "glow": {"type": "array", "items": {"type": "integer"}},
                "shape": {"type": "string", "enum": ["rect", "rounded_rect", "circle", "pill", "underline"]},
                "pulse": {"type": "boolean"},
                "label": {"type": "string"}
              }
            }
          },
          "arrows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "properties": {
                "from": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                "to": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                "tag": {"type": "string"},
                "dir": {"type": "string", "enum": ["auto", "left", "right", "up", "down"]}
              }
            }
          }
        }
      }
    }
  }
}
