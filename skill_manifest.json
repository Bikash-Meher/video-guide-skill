{
  "schema_version": "2.0",
  "skill_id": "video-guide-skill",
  "name": "Video Guide Skill",
  "version": "1.0.0",
  "description": "Zero-manual-recipe AI agent skill: user supplies only a raw screen recording video path (plus optional editing flow notes). The agent extracts 3 FPS frames via FFmpeg, analyzes all extracted frames across the entire video, inspects UI storyboards and key frames, authors timed narration + HUD overlays, validates voice timing, and renders a polished MP4 with SRT captions.",
  "author": "Krishna Vikash ERP",
  "license": "MIT",
  "homepage": "https://github.com/YOUR_USERNAME/video-guide-skill",
  "entrypoint_skill_doc": "SKILL.md",
  "tools": [
    {
      "name": "create_guide",
      "description": "MASTER START TOOL: User gives only `video_path` (plus optional flow notes). Extracts 3 FPS frames via FFmpeg (e.g., 630 frames for 210s), analyzes ALL frames, emits labeled storyboards + analysis_3fps.json + valid starter recipe_draft.json.",
      "parameters": {
        "type": "object",
        "properties": {
          "video_path": {"type": "string", "description": "Absolute path to screen recording."},
          "output_path": {"type": "string", "description": "Optional output .mp4 path."},
          "user_flow_notes": {"type": "string", "description": "Optional user flow notes or instructions."},
          "fps": {"type": "number", "default": 3.0},
          "voice": {"type": "string", "default": "en-IN-NeerjaNeural"},
          "tone": {"type": "string", "enum": ["friendly", "professional", "energetic", "calm", "corporate"], "default": "friendly"},
          "app_name": {"type": "string"}
        },
        "required": ["video_path"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "create_guide"}
    },
    {
      "name": "extract_frames",
      "description": "Extract N-FPS frames via bundled FFmpeg (`--fps_extracted`, default 3.0).",
      "parameters": {
        "type": "object",
        "properties": {
          "video_path": {"type": "string"},
          "fps": {"type": "number", "default": 3.0},
          "output_dir": {"type": "string"},
          "force": {"type": "boolean", "default": false}
        },
        "required": ["video_path"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "extract_frames"}
    },
    {
      "name": "analyze_frames",
      "description": "Analyze ALL extracted 3-FPS frames (`0 .. N-1`), segment UI transitions/actions/idle holds, and render labeled Storyboard Contact Sheets.",
      "parameters": {
        "type": "object",
        "properties": {
          "frames_dir": {"type": "string"},
          "video_path": {"type": "string"},
          "fps": {"type": "number", "default": 3.0}
        },
        "required": ["frames_dir"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "analyze_frames"}
    },
    {
      "name": "inspect_frame_slice",
      "description": "Render dense contact sheet for every consecutive frame in [start_frame .. end_frame].",
      "parameters": {
        "type": "object",
        "properties": {
          "frames_dir": {"type": "string"},
          "start_frame": {"type": "integer"},
          "end_frame": {"type": "integer"},
          "fps": {"type": "number", "default": 3.0}
        },
        "required": ["frames_dir", "start_frame", "end_frame"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "inspect_frame_slice"}
    },
    {
      "name": "scaffold_recipe",
      "description": "Analyze all frames and create an engine.py-compatible starter recipe.json.",
      "parameters": {
        "type": "object",
        "properties": {
          "frames_dir": {"type": "string"},
          "video_path": {"type": "string"},
          "fps": {"type": "number", "default": 3.0},
          "voice": {"type": "string", "default": "en-IN-NeerjaNeural"},
          "tone": {"type": "string", "default": "friendly"},
          "app_name": {"type": "string", "default": "Application"}
        },
        "required": ["frames_dir"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "scaffold_recipe"}
    },
    {
      "name": "validate_recipe",
      "description": "Verify no [AGENT:] placeholders remain and run `engine.py --plan_only` for TTS & overlap checks.",
      "parameters": {
        "type": "object",
        "properties": {
          "recipe_json": {"type": "string"},
          "recipe_path": {"type": "string"}
        }
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "validate_recipe"}
    },
    {
      "name": "render_guide",
      "description": "Render final narrated HUD-annotated MP4 + SRT captions via engine.py.",
      "parameters": {
        "type": "object",
        "properties": {
          "output_path": {"type": "string"},
          "recipe_json": {"type": "string"},
          "recipe_path": {"type": "string"},
          "export_srt": {"type": "boolean", "default": true},
          "voice": {"type": "string"},
          "tone": {"type": "string"}
        },
        "required": ["output_path"]
      },
      "executor": {"type": "python_script", "script": "tool_executor.py", "tool_key": "render_guide"}
    }
  ],
  "runtime": {
    "language": "python",
    "min_version": "3.11",
    "package_manager": "uv",
    "bootstrap_command": "python bootstrap.py",
    "dependencies": [
      "opencv-python>=4.9",
      "pillow>=10.0",
      "imageio-ffmpeg>=0.4",
      "edge-tts>=6.1",
      "numpy>=1.26",
      "mcp>=1.0"
    ]
  },
  "mcp": {
    "server_script": "mcp_server.py",
    "transport": "stdio"
  }
}
